$(info Starting Makevars -------------------------------------------)

# ============================================================================
# R PACKAGE BUILD CONFIGURATION
#
# This file is generated from Makevars.in by the top-level `configure` script.
# All @PLACEHOLDER@ tokens are substituted at configure time; do not edit the
# generated Makevars directly.
# ============================================================================

CXX_STD=CXX17

# ----------------------------------------------------------------------------
# Compiler flags
# ----------------------------------------------------------------------------
# ARMA_64BIT_WORD: kept in sync with libactionet_config.hpp so Rcpp-side call
# sites see the same Armadillo storage widths as the linked static library.
# The OpenMP CXX flags come from R (SHLIB_OPENMP_CXXFLAGS) when available; the
# ACTIONET_OPENMP_CXXFLAGS substitution is only non-empty on macOS when R's
# copy is empty and configure had to synthesize -Xclang -fopenmp -I<libomp>.
PKG_CPPFLAGS=-I"../inst/include" -I"libactionet/include" -I"libactionet/include/extern" -DARMA_64BIT_WORD -DLIBACTIONET_NO_HDF5
PKG_CXXFLAGS=$(SHLIB_OPENMP_CXXFLAGS) @ACTIONET_OPENMP_CXXFLAGS@

# ----------------------------------------------------------------------------
# Linker flags
# ----------------------------------------------------------------------------
# PKG_LIBS_ARCHIVE_FLAGS is filled by configure with the platform-appropriate
# "force load every object in libactionet.a" invocation:
#   * macOS : -Wl,-force_load,<path>   (or space-safe -Xlinker form)
#   * Linux : -Wl,--whole-archive <path> -Wl,--no-whole-archive
#   * Other : plain <path>
# Selecting the branch in configure (not here) keeps this file portable across
# GNU make and BSD make (CRAN "Writing R Extensions" §1.2.6).
PKG_LIBS=@PKG_LIBS_ARCHIVE_FLAGS@ $(SHLIB_OPENMP_LDFLAGS) @ACTIONET_OPENMP_LDFLAGS@ $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)
