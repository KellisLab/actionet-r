#!/bin/sh

set -e  # Exit on first error

echo "Starting configure -------------------------------------------"

# ============================================================================
# PLATFORM DETECTION
# ============================================================================

# Detect platform
UNAME=$(uname -s)

case "${UNAME}" in
    Linux)
        echo "configure: Configuring for Linux"
        NPROC=$(nproc 2>/dev/null || echo 1)
        ;;
    Darwin)
        echo "configure: Configuring for macOS"
        NPROC=$(sysctl -n hw.logicalcpu 2>/dev/null || echo 1)
        ;;
    *)
        echo "Warning: Unknown platform ${UNAME}, using single processor"
        NPROC=1
        ;;
esac

# Ensure R_HOME is set
: "${R_HOME=$(R RHOME 2>/dev/null)}"
if test -z "${R_HOME}"; then
    echo "ERROR: Could not find R_HOME. Please ensure R is installed and in PATH."
    exit 1
fi
echo "Using R_HOME: ${R_HOME}"

escape_sed_replacement() {
    printf "%s" "$1" | sed -e 's/[&|]/\\&/g'
}

normalize_flags() {
    printf "%s" "$1" | tr '\n' ' ' | sed -e 's/[[:space:]]\+/ /g' -e 's/^ //' -e 's/ $//'
}

# Get R compiler settings
CC=$("${R_HOME}/bin/R" CMD config CC)
CXX=$("${R_HOME}/bin/R" CMD config CXX)
CFLAGS=$("${R_HOME}/bin/R" CMD config CFLAGS)
CXXFLAGS=$("${R_HOME}/bin/R" CMD config CXXFLAGS)
FFLAGS=$("${R_HOME}/bin/R" CMD config FFLAGS)

# ============================================================================
# macOS ARCHITECTURE DETECTION (for Rosetta compatibility)
# ============================================================================

OSX_ARCH=""
if [ "${UNAME}" = "Darwin" ]; then
    # Use R's detected architecture, not uname -m (which may be wrong under Rosetta)
    OSX_ARCH=$("${R_HOME}/bin/Rscript" -e 'cat(R.version[["arch"]])' 2>/dev/null | tr -d '[:space:]')
    if [ -z "${OSX_ARCH}" ]; then
        echo "Warning: Could not detect R architecture, will use system default"
    else
        echo "Detected R target architecture: ${OSX_ARCH}"
        # Normalize architecture name
        case "${OSX_ARCH}" in
            aarch64)
                OSX_ARCH="arm64"
                echo "  Normalized to: ${OSX_ARCH}"
                ;;
        esac
    fi
fi

# CHOLMOD dependency removed - library now uses native Armadillo implementations
# ============================================================================
# OPENMP CONFIGURATION (from R)
# ============================================================================

echo "Using OpenMP flags from R..."
R_OPENMP_CXXFLAGS=$("${R_HOME}/bin/R" CMD config SHLIB_OPENMP_CXXFLAGS 2>/dev/null || true)
R_OPENMP_LDFLAGS=$("${R_HOME}/bin/R" CMD config SHLIB_OPENMP_LDFLAGS 2>/dev/null || true)

case "${R_OPENMP_CXXFLAGS}" in
    ERROR:*|*no\ information\ for\ variable*)
        R_OPENMP_CXXFLAGS=""
        ;;
esac
case "${R_OPENMP_LDFLAGS}" in
    ERROR:*|*no\ information\ for\ variable*)
        R_OPENMP_LDFLAGS=""
        ;;
esac

# Fallback: check user Makevars for OpenMP flags
if [ -z "${R_OPENMP_CXXFLAGS}" ] && [ -z "${R_OPENMP_LDFLAGS}" ]; then
    R_MAKEVARS_USER_PATH="${R_MAKEVARS_USER:-$("${R_HOME}/bin/R" CMD config R_MAKEVARS_USER 2>/dev/null || true)}"
    
    # Handle ERROR output from R CMD config
    case "${R_MAKEVARS_USER_PATH}" in
        ERROR:*|*no\ information\ for\ variable*)
            R_MAKEVARS_USER_PATH=""
            ;;
    esac
    
    if [ -z "${R_MAKEVARS_USER_PATH}" ]; then
        R_MAKEVARS_USER_PATH="${HOME}/.R/Makevars"
    fi

    case "${R_MAKEVARS_USER_PATH}" in
        "~/"*)
            R_MAKEVARS_USER_PATH="${HOME}/${R_MAKEVARS_USER_PATH#~/}"
            ;;
    esac

    if [ -f "${R_MAKEVARS_USER_PATH}" ]; then
        echo "  Checking user Makevars at: ${R_MAKEVARS_USER_PATH}"
        
        # Parse Makevars directly using grep/sed (more reliable than make-based approach)
        # Extract SHLIB_OPENMP_CXXFLAGS value (handle both = and := assignments)
        R_OPENMP_CXXFLAGS=$(grep -E "^SHLIB_OPENMP_CXXFLAGS[[:space:]]*[:?]?=" "${R_MAKEVARS_USER_PATH}" 2>/dev/null | \
                            sed -E 's/^SHLIB_OPENMP_CXXFLAGS[[:space:]]*[:?]?=[[:space:]]*//' | \
                            head -1 || true)
        
        # Extract SHLIB_OPENMP_LDFLAGS value
        R_OPENMP_LDFLAGS=$(grep -E "^SHLIB_OPENMP_LDFLAGS[[:space:]]*[:?]?=" "${R_MAKEVARS_USER_PATH}" 2>/dev/null | \
                           sed -E 's/^SHLIB_OPENMP_LDFLAGS[[:space:]]*[:?]?=[[:space:]]*//' | \
                           head -1 || true)
        
        # Strip any trailing comments
        R_OPENMP_CXXFLAGS=$(echo "${R_OPENMP_CXXFLAGS}" | sed 's/#.*//' | sed 's/[[:space:]]*$//')
        R_OPENMP_LDFLAGS=$(echo "${R_OPENMP_LDFLAGS}" | sed 's/#.*//' | sed 's/[[:space:]]*$//')
        
        if [ -n "${R_OPENMP_CXXFLAGS}" ] || [ -n "${R_OPENMP_LDFLAGS}" ]; then
            echo "  Found OpenMP flags in user Makevars:"
            [ -n "${R_OPENMP_CXXFLAGS}" ] && echo "    SHLIB_OPENMP_CXXFLAGS: ${R_OPENMP_CXXFLAGS}"
            [ -n "${R_OPENMP_LDFLAGS}" ] && echo "    SHLIB_OPENMP_LDFLAGS: ${R_OPENMP_LDFLAGS}"
        fi
    fi
fi

echo "  SHLIB_OPENMP_CXXFLAGS: ${R_OPENMP_CXXFLAGS}"
echo "  SHLIB_OPENMP_LDFLAGS: ${R_OPENMP_LDFLAGS}"

if [ -z "${R_OPENMP_CXXFLAGS}" ] && [ -z "${R_OPENMP_LDFLAGS}" ]; then
    echo "  OpenMP disabled by R configuration"
elif [ -n "${R_OPENMP_CXXFLAGS}" ] && [ -z "${R_OPENMP_LDFLAGS}" ]; then
    echo "  Warning: SHLIB_OPENMP_LDFLAGS is empty. Add -L<libomp>/lib -lomp to link OpenMP on macOS."
fi

# Convert flags into CMake-friendly lists (semicolon-delimited)
R_OPENMP_CXXFLAGS_LIST=$(printf "%s" "${R_OPENMP_CXXFLAGS}" | tr ' \t' ';')
R_OPENMP_LDFLAGS_LIST=$(printf "%s" "${R_OPENMP_LDFLAGS}" | tr ' \t' ';')

# ============================================================================
# HDF5 CONFIGURATION (for final R shared library link)
# ============================================================================

echo "Detecting HDF5 flags for R shared library..."
ACTIONET_HDF5_CFLAGS=$(normalize_flags "${ACTIONET_HDF5_CFLAGS}")
ACTIONET_HDF5_LIBS=$(normalize_flags "${ACTIONET_HDF5_LIBS}")

if [ -n "${ACTIONET_HDF5_CFLAGS}" ] || [ -n "${ACTIONET_HDF5_LIBS}" ]; then
    echo "  Using ACTIONET_HDF5_* environment overrides"
else
    if command -v pkg-config >/dev/null 2>&1; then
        for hdf5_pkg in hdf5 hdf5-serial; do
            if pkg-config --exists "${hdf5_pkg}" 2>/dev/null; then
                ACTIONET_HDF5_CFLAGS=$(normalize_flags "$(pkg-config --cflags "${hdf5_pkg}" 2>/dev/null || true)")
                ACTIONET_HDF5_LIBS=$(normalize_flags "$(pkg-config --libs "${hdf5_pkg}" 2>/dev/null || true)")
                if [ -n "${ACTIONET_HDF5_LIBS}" ]; then
                    echo "  Found HDF5 flags via pkg-config (${hdf5_pkg})"
                    break
                fi
            fi
        done
    fi

    if [ -z "${ACTIONET_HDF5_LIBS}" ] && command -v h5cc >/dev/null 2>&1; then
        H5CC_SHOW=$(h5cc -show 2>/dev/null || true)
        ACTIONET_HDF5_CFLAGS=$(normalize_flags "$(printf "%s\n" "${H5CC_SHOW}" | awk '{for (i = 1; i <= NF; ++i) if ($i ~ /^-I/) printf "%s ", $i}')")
        ACTIONET_HDF5_LIBS=$(normalize_flags "$(printf "%s\n" "${H5CC_SHOW}" | awk '{for (i = 1; i <= NF; ++i) if ($i ~ /^-L/ || $i ~ /^-l/ || $i ~ /^-Wl,/ || $i ~ /^-pthread$/ || $i ~ /^\/.*\.(a|so|dylib)$/) printf "%s ", $i}')")
        if [ -n "${ACTIONET_HDF5_LIBS}" ]; then
            echo "  Found HDF5 flags via h5cc"
        fi
    fi
fi

if [ -z "${ACTIONET_HDF5_LIBS}" ]; then
    echo "ERROR: Could not determine HDF5 link flags for actionet.so"
    echo "Please install the HDF5 development package or set ACTIONET_HDF5_CFLAGS / ACTIONET_HDF5_LIBS."
    exit 1
fi

echo "  ACTIONET_HDF5_CFLAGS: ${ACTIONET_HDF5_CFLAGS}"
echo "  ACTIONET_HDF5_LIBS: ${ACTIONET_HDF5_LIBS}"

# ============================================================================
# BUILD CONFIGURATION
# ============================================================================

# Compute absolute path for libactionet.a
ACTIONET_LIB_PATH="$(cd src && pwd)/lib/libactionet.a"
ACTIONET_HDF5_CFLAGS_ESCAPED=$(escape_sed_replacement "${ACTIONET_HDF5_CFLAGS}")
ACTIONET_HDF5_LIBS_ESCAPED=$(escape_sed_replacement "${ACTIONET_HDF5_LIBS}")
echo "libactionet will be built at: ${ACTIONET_LIB_PATH}"

# Generate Makevars from template
echo "Generating src/Makevars from template..."
cd src
echo "Removing stale R package build artifacts..."
rm -f ./*.o ./*.so ./*.dll ./*.dylib
sed \
    -e "s|@ACTIONET_LIB_PATH@|${ACTIONET_LIB_PATH}|g" \
    -e "s|@ACTIONET_HDF5_CFLAGS@|${ACTIONET_HDF5_CFLAGS_ESCAPED}|g" \
    -e "s|@ACTIONET_HDF5_LIBS@|${ACTIONET_HDF5_LIBS_ESCAPED}|g" \
    -e "s|@NPROC@|${NPROC}|g" \
    Makevars.in > Makevars

echo "Generated Makevars successfully"

# ============================================================================
# CMAKE BUILD OF libactionet
# ============================================================================

# Locate cmake
CMAKE_BIN=""
for cmake_path in cmake /opt/homebrew/bin/cmake /usr/local/bin/cmake; do
    if command -v "${cmake_path}" >/dev/null 2>&1; then
        CMAKE_BIN="${cmake_path}"
        break
    fi
done

if [ -z "${CMAKE_BIN}" ]; then
    echo "ERROR: cmake not found in PATH or common locations"
    exit 1
fi
echo "Using cmake: ${CMAKE_BIN}"

# Build libactionet
echo "Building libactionet static library..."
BUILD_DIR="lib"
mkdir -p "${BUILD_DIR}" && cd "${BUILD_DIR}" || exit 1

# Prepare CMake flags
CMAKE_FLAGS="${CMAKE_FLAGS} -DCMAKE_BUILD_TYPE=Release"
CMAKE_FLAGS="${CMAKE_FLAGS} -DBUILD_SHARED_LIBS:bool=OFF"
CMAKE_FLAGS="${CMAKE_FLAGS} -DCMAKE_POSITION_INDEPENDENT_CODE:bool=ON"
CMAKE_FLAGS="${CMAKE_FLAGS} -DLIBACTIONET_BUILD_R=1"
CMAKE_FLAGS="${CMAKE_FLAGS} -DR_HOME='${R_HOME}'"
CMAKE_FLAGS="${CMAKE_FLAGS} -DLIBACTIONET_BUILD_VALIDATORS=OFF"
if [ -n "${R_OPENMP_CXXFLAGS_LIST}" ]; then
    CMAKE_FLAGS="${CMAKE_FLAGS} -DLIBACTIONET_OPENMP_CXXFLAGS=${R_OPENMP_CXXFLAGS_LIST}"
fi
if [ -n "${R_OPENMP_LDFLAGS_LIST}" ]; then
    CMAKE_FLAGS="${CMAKE_FLAGS} -DLIBACTIONET_OPENMP_LDFLAGS=${R_OPENMP_LDFLAGS_LIST}"
fi

# Add macOS architecture flag if detected
if [ "${UNAME}" = "Darwin" ] && [ -n "${OSX_ARCH}" ]; then
    CMAKE_FLAGS="${CMAKE_FLAGS} -DCMAKE_OSX_ARCHITECTURES=${OSX_ARCH}"
fi

# Configure and build
${CMAKE_BIN} -S ../libactionet ${CMAKE_FLAGS}
echo "Building with ${NPROC} processors..."
make -j"${NPROC}"

echo "Build complete!"
